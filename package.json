{
  "name": "strapi-plugin-email-designer-5",
  "version": "0.0.9",
  "description": "Strapi Email Designer (v5)",
  "keywords": [
    "strapi5",
    "strapi-plugin",
    "strapi-email-designer-5"
  ],
  "homepage": "https://github.com/BayBreezy/strapi-plugin-email-designer-5.git",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/BayBreezy/strapi-plugin-email-designer-5.git"
  },
  "maintainers": [
    {
      "name": "Behon Baker",
      "email": "behon.baker@yahoo.com",
      "url": "https://behonbaker.com",
      "github": "BayBreezy"
    }
  ],
  "license": "MIT",
  "author": {
    "name": "Behon Baker",
    "email": "behon.baker@yahoo.com",
    "url": "https://behonbaker.com"
  },
  "type": "commonjs",
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "types": "./dist/admin/src/index.d.ts",
      "source": "./admin/src/index.ts",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "types": "./dist/server/src/index.d.ts",
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "lint-staged": {
    "*.{ts,tsx,json,js}": [
      "prettier --write",
      "bash -c 'bun run test:ts:back'",
      "bash -c 'bun run test:ts:front'"
    ]
  },
  "scripts": {
    "afterClone": "rm -rf dist node_modules bun.lock && bun install",
    "build": "strapi-plugin build",
    "format": "bunx prettier --write .",
    "format:check": "bunx prettier -c .",
    "prepare": "husky",
    "release": "bun run format && bun run build && bun run verify && changelogen --release && npm publish && git push --follow-tags",
    "test:ts:back": "bunx tsc -p server/tsconfig.json --noEmit",
    "test:ts:front": "bunx tsc -p admin/tsconfig.json --noEmit",
    "verify": "strapi-plugin verify",
    "watch": "strapi-plugin watch",
    "watch:link": "strapi-plugin watch:link"
  },
  "dependencies": {
    "@strapi/design-system": "^2.2.4",
    "@strapi/icons": "^2.2.4",
    "dayjs": "^1.11.23",
    "decode-html": "^2.0.0",
    "defu": "^6.1.7",
    "destr": "^2.0.5",
    "html-to-text": "^10.0.1",
    "lodash": "^4.18.1",
    "mustache": "^4.2.0",
    "react-diff-viewer-continued": "^4.4.0",
    "react-email-editor": "^2.1.3",
    "react-icons": "^5.7.0",
    "react-intl": "^6.8.9",
    "react-textarea-autosize": "^8.5.9",
    "striptags": "^3.2.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@strapi/sdk-plugin": "^6.1.1",
    "@strapi/strapi": "^5.56.0",
    "@strapi/typescript-utils": "^5.56.0",
    "@types/html-to-text": "^9.0.4",
    "@types/lodash": "^4.17.25",
    "@types/mustache": "^4.2.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/react-email-editor": "^1.7.0",
    "changelogen": "^0.6.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "styled-components": "^6.5.3",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@strapi/sdk-plugin": "^5.2.6",
    "@strapi/strapi": "^5.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "styled-components": "^6.1.13"
  },
  "strapi": {
    "kind": "plugin",
    "name": "email-designer-5",
    "displayName": "Email Designer 5",
    "description": "Strapi Email Designer (v5)"
  },
  "trustedDependencies": [
    "@swc/core",
    "core-js-pure"
  ]
}
